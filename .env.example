# --- Inicio de sesión con Discord (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- NextAuth ---
# Una clave larga al azar (puedes generarla en https://generate-secret.vercel.app/32)
NEXTAUTH_SECRET=
# La dirección final de tu página, por ejemplo https://torneo-udec.vercel.app
NEXTAUTH_URL=

# --- Base de datos (Neon, desde Vercel > Storage). Vercel la crea sola al conectarla. ---
DATABASE_URL=

# --- Administradores: IDs de Discord separados por coma ---
ADMIN_DISCORD_IDS=
